@page "{id:guid}"
@model ReviewModel
@{
    ViewData["Title"] = "Review Draft";
    var run = Model.Run!;
    var canAct = run.Status == "NeedsHumanReview";
}

<h1>Review Draft</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<div class="card">
    <p class="meta">Run ID: <code>@run.Id</code> &nbsp;|&nbsp; Created: @run.CreatedUtc.ToLocalTime().ToString("g")</p>
    <p><strong>Goal:</strong> @run.UserGoal</p>
    @if (run.ProjectArea is not null)
    {
        <p><strong>Area:</strong> @run.ProjectArea</p>
    }
    <p>Status: <span class="status-badge status-@run.Status">@run.Status</span></p>
    @if (run.PromptTemplateName is not null)
    {
        <p class="meta">
            Template: <code>@run.PromptTemplateName</code>
            @if (run.PromptTemplateVersion is not null)
            {
                <span>&nbsp;·&nbsp;version <code>@run.PromptTemplateVersion</code></span>
            }
        </p>
    }
</div>

@if (run.GeneratedDraft is not null)
{
    <div class="card">
        <h2>Generated Draft</h2>
        <div class="draft-box">@run.GeneratedDraft</div>
    </div>
}

@if (run.FinalOutput is not null)
{
    <div class="card">
        <h2>Final Output</h2>
        <div class="draft-box">@run.FinalOutput</div>
    </div>
}

@if (canAct)
{
    <div class="card">
        <h2>Your Decision</h2>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-bottom:1.5rem;">
            <form method="post" asp-page-handler="Approve" class="action-form">
                <input type="hidden" name="id" value="@run.Id" />
                <button class="btn btn-success action-btn">✓ Approve</button>
            </form>
            <form method="post" asp-page-handler="Regenerate" class="action-form">
                <input type="hidden" name="id" value="@run.Id" />
                <button class="btn btn-warning action-btn">↻ Regenerate</button>
                <span class="action-spinner" style="display:none;margin-left:0.5rem;">
                    <span class="spinner"></span> Regenerating — this may take a minute&hellip;
                </span>
            </form>
        </div>

        <form method="post" asp-page-handler="Reject" class="action-form" style="margin-bottom:1.5rem;">
            <input type="hidden" name="id" value="@run.Id" />
            <div class="field-group" style="margin-bottom:0.5rem;">
                <label for="reject-reason" style="font-size:0.875rem;font-weight:600;">Reject reason <span class="meta">(optional)</span></label>
                <input id="reject-reason" name="reason" type="text"
                       placeholder="e.g. Off-topic, too verbose, incorrect…"
                       style="display:block;width:100%;max-width:480px;margin-top:0.3rem;" />
            </div>
            <button class="btn btn-danger action-btn">✗ Reject</button>
        </form>

        <h2>Edit &amp; Approve</h2>
        <form method="post" asp-page-handler="EditAndApprove" class="action-form">
            <input type="hidden" name="id" value="@run.Id" />
            <div class="field-group">
                <label for="editedOutput">Edit the draft, then approve your version:</label>
                <textarea id="editedOutput" name="editedOutput" rows="12">@run.GeneratedDraft</textarea>
            </div>
            <button class="btn btn-primary action-btn">✎ Edit &amp; Approve</button>
            <span class="action-spinner" style="display:none;margin-left:0.5rem;">
                <span class="spinner"></span> Saving&hellip;
            </span>
        </form>
    </div>
}

<style>
.spinner {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid #ccc;
    border-top-color: #555;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 0.3rem;
}
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<p style="margin-top:1rem;"><a asp-page="/Runs">← Back to Recent Runs</a></p>

<!-- Detail expand modal (must be in DOM before the script block below) -->
<div id="detail-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:8px;max-width:680px;width:90%;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 8px 32px rgba(0,0,0,0.22);">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;border-bottom:1px solid #eee;">
            <strong id="detail-modal-title" style="font-size:1rem;"></strong>
            <button onclick="closeDetailModal()" style="background:none;border:none;font-size:1.25rem;cursor:pointer;line-height:1;">&times;</button>
        </div>
        <pre id="detail-modal-body" style="margin:0;padding:1.25rem;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:inherit;font-size:0.875rem;flex:1;"></pre>
    </div>
</div>

<script>
document.querySelectorAll('.action-form').forEach(function (form) {
    form.addEventListener('submit', function () {
        form.querySelectorAll('.action-btn').forEach(function (btn) { btn.disabled = true; });
        var spinner = form.querySelector('.action-spinner');
        if (spinner) spinner.style.display = 'inline';
    });
});

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.detail-preview').forEach(function (el) {
        el.addEventListener('click', function () {
            var raw = el.getAttribute('data-detail');
            var action = el.closest('tr').querySelector('td:nth-child(2)').textContent.trim();
            openDetailModal(action, raw);
        });
    });
});

function openDetailModal(title, text) {
    document.getElementById('detail-modal-title').textContent = title;
    document.getElementById('detail-modal-body').textContent = text;
    var modal = document.getElementById('detail-modal');
    modal.style.display = 'flex';
}

function closeDetailModal() {
    document.getElementById('detail-modal').style.display = 'none';
}

document.getElementById('detail-modal').addEventListener('click', function (e) {
    if (e.target === this) closeDetailModal();
});
</script>

@if (Model.Events.Count > 0)
{
    <div class="card">
        <h2>Audit Trail</h2>
        <table style="width:100%;border-collapse:collapse;font-size:0.875rem;">
            <thead>
                <tr style="text-align:left;border-bottom:1px solid #ddd;">
                    <th style="padding:0.4rem 0.75rem;">Time</th>
                    <th style="padding:0.4rem 0.75rem;">Action</th>
                    <th style="padding:0.4rem 0.75rem;">Actor</th>
                    <th style="padding:0.4rem 0.75rem;">Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.Events)
                {
                    <tr style="border-bottom:1px solid #f0f0f0;">
                        <td style="padding:0.4rem 0.75rem;white-space:nowrap;">
                            @ev.OccurredUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td style="padding:0.4rem 0.75rem;">@ev.Action</td>
                            <td style="padding:0.4rem 0.75rem;">@ev.ActorType</td>
                            <td style="padding:0.4rem 0.75rem;color:#666;">
                                @if (ev.Detail is not null)
                                {
                                    var preview = ev.Detail.Length > 80 ? ev.Detail[..80].Replace("\n", " ") + "…" : ev.Detail.Replace("\n", " ");
                                    if (ev.Detail.Length > 80)
                                    {
                                        <span class="detail-preview" style="cursor:pointer;text-decoration:underline dotted;" data-detail="@ev.Detail" title="Click to expand">@preview</span>
                                    }
                                    else
                                    {
                                        @preview
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
